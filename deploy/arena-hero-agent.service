[Unit]
Description=Arena Hero resource collection agent
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=arena-hero
Group=arena-hero
SupplementaryGroups=arena-hero-observe arena-hero-tactical
WorkingDirectory=/opt/arena-hero-agent/current
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
Environment=ARENA_WORKER_TARGET=12
Environment=ARENA_BEACON_POLICY=retreat
Environment=ARENA_TUNING_GENERATION=0
EnvironmentFile=/etc/arena-hero-agent.env
EnvironmentFile=-/etc/arena-hero-agent/runtime.env
Environment=ARENA_TACTICAL_ROOT=/var/lib/arena-hero-tactical
RuntimeDirectory=arena-hero-agent
RuntimeDirectoryMode=0750
ExecStart=/opt/arena-hero-agent/current/.venv/bin/arena-hero-agent --env-file /etc/arena-hero-agent.env --worker-target ${ARENA_WORKER_TARGET} --beacon-policy ${ARENA_BEACON_POLICY} --heartbeat-file /run/arena-hero-agent/heartbeat.json --observation-dir /var/lib/arena-hero-observability/inbox --tactical-root ${ARENA_TACTICAL_ROOT} --stale-turn-timeout-seconds 90
Restart=on-failure
RestartPreventExitStatus=2 10 11 12 13 14 130
RestartForceExitStatus=75
RestartSec=15s
WatchdogSec=120s
WatchdogSignal=SIGABRT
LimitCORE=0
NotifyAccess=main
KillSignal=SIGINT
TimeoutStopSec=20s
UMask=0077
MemoryHigh=192M
MemoryMax=256M

NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
ReadWritePaths=/var/lib/arena-hero-observability/inbox /var/lib/arena-hero-tactical
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
SystemCallArchitectures=native

StandardOutput=journal
StandardError=journal
SyslogIdentifier=arena-hero-agent

[Install]
WantedBy=multi-user.target
